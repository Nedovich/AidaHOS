{
  "name": "aidahos",
  "version": "0.0.0",
  "private": true,
  "description": "AidaHOS — multi-tenant Hotel Operating System (admin + guest + integration API)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:push": "pnpm --filter @aidahos/db push",
    "db:generate": "pnpm --filter @aidahos/db generate",
    "db:studio": "pnpm --filter @aidahos/db studio",
    "db:seed": "pnpm --filter @aidahos/web exec tsx scripts/seed.ts"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
