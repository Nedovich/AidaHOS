# ============================================================
# AidaHOS — environment template. Copy to .env and fill in.
# ============================================================

# --- PostgreSQL (REMOTE — cpx31-main-server, managed via Coolify) ---
# Dev runs locally but uses the server's Postgres. Use sslmode=require for a public
# TLS endpoint; omit/relax when reaching it via Tailscale.
# Runtime: least-privilege NON-owner role so Postgres RLS is enforced.
DATABASE_URL=postgres://aidahos_app:PASSWORD@HOST:5432/aidahos?sslmode=require
# Migrations/DDL (drizzle-kit): run as the table OWNER (owner bypasses RLS).
MIGRATION_DATABASE_URL=postgres://aida_master:PASSWORD@HOST:5432/aidahos?sslmode=require

# --- BetterAuth (apps/web, runs locally on :3000) ---
BETTER_AUTH_SECRET=change-me-32-chars-min
BETTER_AUTH_URL=http://localhost:3000

# --- Web -> FastAPI service-to-service ---
# Our apps/api deploys as a SEPARATE Coolify app (NOT the existing Aida-API).
# Needed from Phase 3 onward; set to the deployed URL then. Local fallback below.
API_BASE_URL=http://localhost:8000
API_SERVICE_TOKEN=change-me-shared-hmac-secret

# --- apps/guest ---
NEXT_PUBLIC_GUEST_DEFAULT_HOTEL=demo

# --- apps/api (FastAPI) ---
APP_ENV=development
SERVICE_TOKEN=change-me-shared-hmac-secret
# Tailscale: API joins the tailnet to reach on-prem hotel boxes (no public ports)
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=aidahos-api
