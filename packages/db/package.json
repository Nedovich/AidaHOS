{
  "name": "@aidahos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./portal-config": "./src/portal-config.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push --force && node scripts/apply-rls.mjs",
